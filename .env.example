# Copia este fichero a .env y rellena los valores.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# URL pública sin barra final (obligatoria en producción). Se usa en canonical, sitemap y enlaces NFC.
PUBLIC_BASE_URL=http://localhost:3000

# Número de WhatsApp con prefijo de país, solo dígitos (obligatorio en producción).
WHATSAPP_NUMBER=34600000000
CONTACT_EMAIL=contacto@tudominio.es

# Ruta del fichero SQLite. En Docker/producción debe estar en un volumen persistente.
DATABASE_PATH=./data/app.db

# Opcional: webhook de Slack/Discord/Make/n8n para recibir un aviso por cada lead nuevo.
NOTIFY_WEBHOOK_URL=

# Pon true si la app va detrás de un proxy inverso (Caddy, Nginx, Fly, Railway...) para leer bien la IP real.
TRUST_PROXY=false

SESSION_TTL_DAYS=7
LOG_LEVEL=info
