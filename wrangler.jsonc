// Cloudflare Workers (proyecto "alcance-isle-o"): construye la web estática y publica dist/.
// Las cabeceras de seguridad salen del _headers que genera la construcción.
{
  "name": "alcance-isle-o",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "PUBLIC_BASE_URL=https://alcance-isle-o.ariel-diaz662.workers.dev npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
