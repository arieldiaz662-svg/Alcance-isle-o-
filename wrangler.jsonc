// Cloudflare Workers (Worker "alcance-isleno"): pasa los tests, construye la web estática y publica
// dist/ en alcanceisleno.com. Si falla un test, no se publica.
// worker/index.js redirige www y workers.dev al dominio principal; las cabeceras de seguridad salen
// del _headers que genera la construcción.
{
  "name": "alcance-isleno",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Vistas previas de las PR: Cloudflare ejecuta "wrangler preview" en las ramas que no son main,
  // y ese comando exige este bloque (puede ir vacío; assets y demás se heredan de arriba).
  "previews": {},
  "build": {
    "command": "npm test && PUBLIC_BASE_URL=https://alcanceisleno.com npm run build"
  },
  "routes": [
    { "pattern": "alcanceisleno.com", "custom_domain": true },
    { "pattern": "www.alcanceisleno.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
